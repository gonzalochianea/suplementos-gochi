# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB (Local o Mongo Atlas)
MONGO_URI=mongodb://localhost:27017/nombre_de_tu_base_de_datos

# Secreto para firma de JWT y tiempo de expiración
JWT_SECRET=tu_clave_secreta_jwt
JWT_EXPIRES_IN=2h

# Modo de almacenamiento: "local" o "supabase"
STORAGE=local
IMAGES_FOLDER=uploads
API_URL=http://localhost:3000

# Credenciales de Supabase Storage
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase
